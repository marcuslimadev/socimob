# Use PHP 8.3 for this domain
AddHandler application/x-httpd-php83 .php

# PHP limits for file uploads and image processing
php_value memory_limit 512M
php_value max_execution_time 180
php_value upload_max_filesize 100M
php_value post_max_size 110M

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # SEO por domínio: a home e o sitemap da Exclusiva são renderizados pelo
    # Laravel para entregar metadados corretos também a crawlers sem JavaScript.
    RewriteCond %{HTTP_HOST} ^(www\.)?exclusiva(r)?larimoveis\.com(\.br)?$ [NC]
    RewriteRule ^$ public/index.php [L]
    RewriteCond %{HTTP_HOST} ^(www\.)?exclusiva(r)?larimoveis\.com(\.br)?$ [NC]
    RewriteRule ^robots\.txt$ robots-exclusiva.txt [L]
    RewriteCond %{HTTP_HOST} ^(www\.)?exclusiva(r)?larimoveis\.com(\.br)?$ [NC]
    RewriteRule ^sitemap\.xml$ public/index.php [L]

    # Exceção para Portal Svelte (servir arquivos estáticos)
    RewriteCond %{REQUEST_URI} ^/portal/svelte/
    RewriteRule ^ - [L]

    # Servir uploads legados armazenados dentro de public/
    RewriteCond %{REQUEST_URI} ^/(uploads|storage)/(.*)$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/public/%1/%2 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/%1/%2 -d
    RewriteRule ^(uploads|storage)/(.*)$ public/$1/$2 [L]

    # Bloquear acesso direto a arquivos sensiveis e scripts da raiz do repositorio.
    # O documento raiz e o clone git: sem isto, a regra "serve existing files"
    # abaixo entregaria (ou executaria) .env, .git, scripts .php soltos, logs, etc.
    RewriteRule ^\.(?!well-known/) - [F,NC,L]
    RewriteRule ^[^/]+\.(php|sql|log|ps1|sh|phar|lock|md)$ - [F,NC,L]
    RewriteRule ^(artisan|composer\.json|package(-lock)?\.json|pnpm-.+\.yaml|phpunit\.xml|vite\.config\.ts|tailwind\.config\.js|playwright\.config\.ts)$ - [F,NC,L]
    RewriteRule ^(app|bootstrap|config|database|routes|tests|vendor|node_modules|services|scripts|e2e|hf_local_service|chrome-extension)(/|$) - [F,NC,L]
    RewriteRule ^storage/(logs|framework)(/|$) - [F,NC,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Serve existing files/directories directly
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Backend routes go to Laravel
    RewriteCond %{REQUEST_URI} ^/(api|api-public|webhook|webhooks|github|debug|test|sync|integracoes|w|hl|portal/imovel) [NC]
    RewriteRule ^(.*)$ public/index.php [L]

    # SPA fallback for React routes
    RewriteRule ^ index.html [L]
</IfModule>
