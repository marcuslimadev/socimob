DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    Options +FollowSymLinks
    RewriteEngine On

    # Redirecionar www para sem www
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # Servir arquivos estáticos diretamente
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Servir uploads que ficam fisicamente em /public/uploads
    RewriteCond %{REQUEST_URI} ^/uploads/ [NC]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

    # Exceção para arquivos do storage (mídia do WhatsApp)
    RewriteCond %{REQUEST_URI} ^/storage/ [NC]
    RewriteRule ^ - [L]

    # Rotas API/webhook/sync vão para index.php (Lumen)
    RewriteCond %{REQUEST_URI} ^/(api|webhook|sync) [NC]
    RewriteRule ^ index.php [L]

    # Tudo mais vai para index.html (React SPA)
    RewriteRule ^ index.html [L]
</IfModule>

