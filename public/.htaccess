<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Exceção para arquivos do storage (imagens, áudios, vídeos)
    RewriteCond %{REQUEST_URI} ^/storage/
    RewriteRule ^ - [L]

    # Exceção para Portal Svelte (servir arquivos estáticos)
    RewriteCond %{REQUEST_URI} ^/portal/svelte/
    RewriteRule ^ - [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Serve existing files/directories directly
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Backend routes go to Lumen
    RewriteCond %{REQUEST_URI} ^/(api|api-public|webhook|github|debug|test|db-test|migrate-now-please|sync) [NC]
    RewriteRule ^ index.php [L]

    # SPA fallback for React routes
    RewriteRule ^ index.html [L]
</IfModule>
