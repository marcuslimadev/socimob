#!/usr/bin/env php
<?php

use Symfony\Component\Console\Input\ArgvInput;

// Hospedagem compartilhada: o `php` padrao do PATH (cron e SSH) e o 8.0, mas o app exige >= 8.2
// e morre na checagem de plataforma do Composer, o que parou o agendador (schedule:run) sem aviso.
// Em PHP antigo, reexecuta o mesmo comando no PHP 8.3 do servidor, se existir. O PHP 8.0 da
// hospedagem desabilita exec/passthru/system/popen, entao usa pcntl_exec (troca o processo, mantendo
// codigo de saida e E/S) ou, na falta dele, proc_open com stdio herdado.
if (PHP_VERSION_ID < 80200) {
    $alternativePhp = '/opt/alt/php83/usr/bin/php';

    if (is_executable($alternativePhp)) {
        $arguments = array_merge([__FILE__], array_slice($_SERVER['argv'] ?? [], 1));

        if (function_exists('pcntl_exec')) {
            pcntl_exec($alternativePhp, $arguments);
        }

        if (function_exists('proc_open')) {
            $process = proc_open(array_merge([$alternativePhp], $arguments), [0 => STDIN, 1 => STDOUT, 2 => STDERR], $pipes);

            if (is_resource($process)) {
                exit(proc_close($process));
            }
        }
    }
}

define('LARAVEL_START', microtime(true));

// Register the Composer autoloader...
require __DIR__.'/vendor/autoload.php';

// Bootstrap Laravel and handle the command...
$status = (require_once __DIR__.'/bootstrap/app.php')
    ->handleCommand(new ArgvInput);

exit($status);
